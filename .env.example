# ── Server PrimeHorizon (backend-etsy) ──
PRIME_API_BASE=https://api.primehorizon.studio
# PrimeAgent gửi key này khi gọi backend (header X-Service-Key) — trùng AGENT_SERVICE_KEY ở backend
PRIME_SERVICE_KEY=
# Backend gửi key này khi gọi PrimeAgent (header X-Agent-Key) — trùng AGENT_INBOUND_KEY ở backend
AGENT_INBOUND_KEY=

# ── AI ── anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Giới hạn ──
AGENT_CONCURRENCY=2
IMAGE_MAX_PX=1568
MAX_IMAGES=16
MAX_DOWNLOAD_MB=40
HTTP_TIMEOUT=60
AI_TIMEOUT=300
